# Runtime configuration for the Docker containers (copy to .env.docker and fill in).
# The containers use host networking, so 127.0.0.1 is the host's MySQL server.
APP_NAME="10MG Health Lending"
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://127.0.0.1:8080
PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=10mg
DB_USERNAME=root
DB_PASSWORD=

# Idempotency locks and cache live in MySQL (cache / cache_locks tables).
# Switch to CACHE_STORE=redis + REDIS_HOST when a Redis server is available.
CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# Start-up behaviour (docker/entrypoint.sh)
RUN_MIGRATIONS=true
RUN_SEEDERS=false

# Default KYC policy for lenders that have not set their own (each lender changes it via PATCH /kyc-settings).
LENDING_REQUIRE_KYC=true
LENDING_KYC_BVN_CHECK=true
LENDING_KYC_NIN_CHECK=true
LENDING_KYC_PHONE_MATCH=false

# 10MG platform fee default for lenders not set individually: basis points of the principal; lender or borrower pays.
PLATFORM_FEE_BPS=50
PLATFORM_FEE_BEARER=lender

# Borrower KYC: sandbox answers BVN/NIN matches locally; set live + credentials for real calls.
NIBSS_MODE=sandbox
NIBSS_BASE_URL=https://api.nibss-plc.com.ng
NIBSS_CLIENT_ID=
NIBSS_CLIENT_SECRET=
NIMC_MODE=sandbox
NIMC_BASE_URL=https://api.nimc.gov.ng
NIMC_CLIENT_ID=
NIMC_CLIENT_SECRET=
